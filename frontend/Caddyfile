# Replaces Railpack's default SPA Caddyfile to add cache headers.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Vite fingerprints everything in /assets, so those files never change.
	# Everything else (index.html above all) must be revalidated, or browsers keep
	# loading an old index.html that points at bundles removed by the next deploy.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"

	root * /app/dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# Missing /assets files must 404 rather than fall back to index.html.
	@spa not path /assets/*
	handle @spa {
		try_files {path} {path}.html {path}/index.html /index.html
	}
}
